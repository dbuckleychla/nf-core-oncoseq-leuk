params {
    qc_extended = true
    qc_methylation = false
    max_cpus = 2
    max_memory = 4.GB
    max_time = 1.h
}
docker.enabled = false
conda.enabled = false
apptainer.enabled = false
singularity.enabled = false
report.enabled = false
timeline.enabled = false
trace.enabled = false
dag.enabled = false
env.PATH = "${System.getenv('ONCOSEQ_QC_TEST_PATH')}:${launchDir}/bin:${System.getenv('PATH')}"
process.executor = 'local'

process {
    withName: 'QC_EXT_.*' {
        ext.qc_python = "${System.getenv('ONCOSEQ_QC_TEST_PATH')}/python"
    }
}
