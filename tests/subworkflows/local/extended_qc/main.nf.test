nextflow_workflow {
    name "Additive QC with private intermediates"
    script "subworkflows/local/extended_qc/main.nf"
    workflow "EXTENDED_QC"
    config "tests/subworkflows/local/extended_qc/local.config"

    test("Complete both samples without modification tags or preprocessing history") {
        when {
            params {
                outdir = "${outputDir}/results"
                qc_targets_bed = "${projectDir}/test_data/qc_extended/targets.bed"
                qc_methylation = false
            }
            workflow {
                """
                params.qc_targets_bed = file(params.qc_targets_bed)
                // Exercise remote Path handling without checking a real S3 object.
                def remote = file('s3://synthetic-qc-assets/targets.bed')
                def source = file('${projectDir}/subworkflows/local/extended_qc/main.nf').text
                def helper = source.substring(source.indexOf('def qcAsset('), source.indexOf('workflow EXTENDED_QC'))
                def binding = new Binding([value: remote, file: { options, value ->
                    assert value instanceof java.nio.file.Path
                    assert options.checkIfExists
                    value
                }])
                assert new GroovyShell(binding).evaluate(helper + '\\nqcAsset(value, null)') == remote
                input[0] = channel.of([[id:'SYNTHETIC_A'], file('${projectDir}/test_data/qc_extended/plain.bam'), file('${projectDir}/test_data/qc_extended/plain.bam.bai')],
                                        [[id:'SYNTHETIC_B'], file('${projectDir}/test_data/qc_extended/plain.bam'), file('${projectDir}/test_data/qc_extended/plain.bam.bai')])
                input[1] = channel.value([[id:'reference'], file('${projectDir}/test_data/qc_extended/reference.fa')])
                input[2] = channel.value([[id:'reference'], file('${projectDir}/test_data/qc_extended/reference.fa.fai')])
                input[3] = channel.of([[id:'SYNTHETIC_A'], file('${projectDir}/test_data/qc_extended/enrichment.bed'), 0, []],
                                        [[id:'SYNTHETIC_B'], file('${projectDir}/test_data/qc_extended/enrichment.bed'), 0, []])
                input[4] = channel.empty()
                input[5] = 'hg38'
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.metrics.size() == 2
            assert workflow.out.sections.size() == 2
            workflow.out.metrics.each { meta, path ->
                def data = new groovy.json.JsonSlurperClassic().parseText(file(path).text)
                assert data.components.methylation.status == 'disabled'
                assert data.metrics.find { it.metric_id == 'alignment.rate' }.value == 0.75
                def published = file("${outputDir}/results/qc_extended/${meta.id}")
                assert published.listFiles().collect { it.name }.sort() == ['metrics.json','summary.tsv','read_lengths.tsv','coverage.tsv','targets.tsv','methylation.tsv','classifier_cpgs.tsv','adequacy.tsv','preprocessing.tsv'].sort()
            }
            workflow.out.sections.each { meta, _section, folder, _name ->
                assert file("${folder}/Extended_QC.qmd").text.contains('Read lengths on/off exact targets')
            }
        }
    }
    test("Publish genome-wide bedMethyl only when methylation is available") {
        when {
            params {
                outdir = "${outputDir}/results"
                qc_targets_bed = "${projectDir}/test_data/qc_extended/targets.bed"
                qc_methylation = true
                qc_test_mock_modkit = true
            }
            workflow {
                """
                params.qc_targets_bed = file(params.qc_targets_bed)
                input[0] = channel.of([[id:'SYNTHETIC'], file('${projectDir}/test_data/qc_extended/tagged.bam'), file('${projectDir}/test_data/qc_extended/tagged.bam.bai')])
                input[1] = channel.value([[id:'reference'], file('${projectDir}/test_data/qc_extended/reference.fa')])
                input[2] = channel.value([[id:'reference'], file('${projectDir}/test_data/qc_extended/reference.fa.fai')])
                input[3] = channel.of([[id:'SYNTHETIC'], file('${projectDir}/test_data/qc_extended/enrichment.bed'), 0, []])
                input[4] = channel.empty()
                input[5] = 'hg38'
                """
            }
        }
        then {
            assert workflow.success
            def published = file("${outputDir}/results/methylation")
            assert file("${published}/SYNTHETIC.genomewide.cpg.bedmethyl.gz").bytes == file("${projectDir}/test_data/qc_extended/mods.bed.gz").bytes
            assert !file("${published}/modkit.version.txt").exists()
            assert !file("${published}/modkit.log").exists()
            assert !file("${published}/pileup.bed.gz").exists()
            def data = new groovy.json.JsonSlurperClassic().parseText(file(workflow.out.metrics[0][1]).text)
            assert data.components.methylation.status in ['complete', 'partial']
        }
    }

}
