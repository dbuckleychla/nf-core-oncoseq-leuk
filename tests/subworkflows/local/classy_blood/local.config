params.classy_blood_enable_alma3 = true
params.classy_blood_alma3_modification_mode = '5mc'
params.cfdna = false
env.PATH = "${projectDir}/tests/subworkflows/local/classy_blood/mock_bin:${projectDir}/bin:${System.getenv('PATH')}"
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    withName: 'CLASSY_BLOOD.*' {
        cpus = 1
        memory = '1 GB'
        ext.threads = 1
        errorStrategy = 'terminate'
    }
}
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
conda.enabled = false
