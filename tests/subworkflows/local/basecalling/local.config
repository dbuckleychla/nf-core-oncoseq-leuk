includeConfig '../../../config/local.config'
params.single_pod5 = false
params.mock_fail_sample = ''
params.mock_fail_shard = 0
params.shard_test_root = ''
trace.enabled = true
process {
    withName: 'DORADO_BASECALL' {
        beforeScript = {
            "mkdir -p mock-bin; ln -s '${params.shard_test_root ?: projectDir}/tests/subworkflows/local/basecalling/mock_dorado.py' mock-bin/dorado; export PATH=\"\$PWD/mock-bin:\$PATH\"; export MOCK_SAMPLE='${meta.basecall_parent.id}' MOCK_SHARD='${meta.basecall_shard}' MOCK_FAIL_SAMPLE='${params.mock_fail_sample}' MOCK_FAIL_SHARD='${params.mock_fail_shard}'"
        }
    }
}
