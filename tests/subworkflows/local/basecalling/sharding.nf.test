nextflow_function {
    name "Deterministic POD5 file-group planning"
    script "subworkflows/local/basecalling/sharding.nf"
    function "planPod5Shards"

    test("Round-robin sorted files into stable nonempty shards") {
        when {
            function {
                """
                def root = file("${projectDir}/tests/subworkflows/local/basecalling/fixtures")
                input[0] = [[[id:'alpha'], root.resolve('alpha'), file("${projectDir}/assets/NOFILE"), root.resolve('base_model'), file("${projectDir}/assets/NOMOD")]]
                input[1] = 3
                """
            }
        }
        then {
            assert function.success
            def rows = function.result
            assert rows.size() == 3
            assert rows.collect { row -> row[0].id } == ['alpha__bc0001', 'alpha__bc0002', 'alpha__bc0003']
            assert rows.collect { row -> row[1].size() } == [2, 2, 1]
            assert rows.every { row -> row[0].basecall_parent == [id:'alpha'] && row[0].basecall_count == 3 }
        }
    }

    test("Reject overlapping POD5 input paths") {
        when {
            function {
                """
                def root = file("${projectDir}/tests/subworkflows/local/basecalling/fixtures")
                def empty = file("${projectDir}/assets/NOFILE")
                def mod = file("${projectDir}/assets/NOMOD")
                input[0] = [[[id:'alpha'], root.resolve('alpha'), empty, root.resolve('base_model'), mod], [[id:'alpha'], root.resolve('alpha/a.pod5'), empty, root.resolve('base_model'), mod]]
                input[1] = 3
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.join('\n').contains('Duplicate POD5 input')
        }
    }

    test("Reject one partial resume BAM reused for several shards") {
        when {
            function {
                """
                def root = file("${projectDir}/tests/subworkflows/local/basecalling/fixtures")
                input[0] = [[[id:'alpha'], root.resolve('alpha'), root.resolve('base_model/config.toml'), root.resolve('base_model'), file("${projectDir}/assets/NOMOD")]]
                input[1] = 3
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.join('\n').contains('shared resume uBAM')
        }
    }
}
