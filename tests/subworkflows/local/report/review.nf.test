nextflow_workflow {
    name "Optional review report"
    script "tests/subworkflows/local/report/workflow.nf"
    workflow "CHECK_REVIEW"
    config "tests/subworkflows/local/report/local.config"

    test("Unpinned development annotations and portable HTML") {
        when {
            params {
                outdir = "${outputDir}/results"
                review_references = new File("test_data/review/unpinned.references.json").absolutePath
            }
        }
        then {
            assert workflow.success
            assert workflow.out.html.size() == 1
            def data = new groovy.json.JsonSlurperClassic().parseText(file("${workflow.out.data[0][1]}/review.json").text)
            assert data.warnings.any { it.contains("unpinned") }
            assert data.small_variants.total_records == 2
            assert data.small_variants.records.every { row -> row.exact_pass_agreement }
            def blood = data.small_variants.records.find { it.coordinates[1] == 150 }
            def expanded = data.small_variants.records.find { it.coordinates[1] == 160 }
            assert blood.selections[0].cosmic_primary
            assert blood.evidence[0].cosmic.targeted_evidence[0].blood_sample_count == 1
            assert !expanded.selections[0].cosmic_primary
            assert expanded.evidence[0].cosmic.targeted_evidence[0].phenotypes[0].classification.PRIMARY_SITE == 'lung'
            assert data.classification[0].score == 0.9
            assert data.runtime_provenance.parameters.basecall_model == 'dna_synthetic@v1'
            assert data.figures.any { it.category == 'classification' && it.path.endsWith('_combined_task_pies.svg') }
            assert data.structural_events.every { event -> !event.selected }
            assert file(workflow.out.html[0][1]).text.contains('SYNTHETIC')
            assert file(workflow.out.html[0][1]).text.contains('"classy_summary":true')
            assert file(workflow.out.html[0][1]).text.contains('"classy_plot":"blood"')
            assert file(workflow.out.html[0][1]).text.contains('10.1186/s13073-026-01815-7')
            assert file(workflow.out.html[0][1]).text.contains('"version":"1.20"')
            assert file("${outputDir}/results/reports/SYNTHETIC.review.html").exists()
            assert file("${outputDir}/results/reports/review/SYNTHETIC/manifest.json").exists()
            assert !file("${outputDir}/results/reports/review/SYNTHETIC/review_data").exists()
        }
    }
    test("Native blood models and ALMA3 approximation reach the final HTML") {
        when {
            params {
                outdir = "${outputDir}/results"
                review_blood = true
            }
        }
        then {
            assert workflow.success
            def html = file(workflow.out.html[0][1]).text
            def data = new groovy.json.JsonSlurperClassic().parseText(file("${workflow.out.data[0][1]}/review.json").text)
            assert data.classification*.name == ['marlin', 'lamprey', 'alma3', 'optic']
            assert !data.classification.find { it.name == 'optic' }.accepted_call
            assert html.contains('ALMA3.1 (native approximation)')
            assert html.contains('Analysis performed using ALMA3.')
            assert html.contains('"specification":"synthetic-v1"')
        }
    }
    test("Empty candidate union remains a completed report") {
        when {
            params {
                outdir = "${outputDir}/results"
                review_empty = true
            }
        }
        then {
            assert workflow.success
            def data = new groovy.json.JsonSlurperClassic().parseText(file("${workflow.out.data[0][1]}/review.json").text)
            assert data.small_variants.total_records == 0
            assert data.statuses['small:deepsomatic'] == 'completed'
            assert file("${outputDir}/results/reports/SYNTHETIC.review.html").exists()
        }
    }

}
