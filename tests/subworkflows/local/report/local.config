params.review_empty = false
params.review_fixture_root = "${projectDir}/test_data/review"
params.review_references = "${params.review_fixture_root}/references.json"
params.review_panel = "${params.review_fixture_root}/panel.tsv"
params.review_fusion_distance = 100
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    withName: 'REVIEW_.*' {
        cpus = 1
        memory = '1 GB'
    }
    withName: 'REVIEW_VEP' {
        container = 'community.wave.seqera.io/library/oncoseq_review_1_0_0@sha256:b143e350e1dae33ad26758fc6f9ccf2392cb8b49881de73960f42525602d5eb5'
        ext.executable = "${params.review_fixture_root}/mock_vep.py"
    }
}
docker.runOptions = '--platform linux/amd64'
