nextflow_process {
    name "Combined classifier required output contract"
    script "modules/local/classifier_process/main.nf"
    process "PARSE_JSON_COMBINED"
    config "tests/config/local.config"

    test("Accept complete supported classifier output without Optic") {
        when {
            process {
                """
                input[0] = [[id:'synthetic'], file("${projectDir}/tests/modules/local/classifier_process/without_optic.json")]
                """
            }
        }
        then {
            assert process.success
            assert process.out.tucan.size() == 1
            assert process.out.lamprey.size() == 1
            assert process.out.sturgeon_general.size() == 1
            assert process.out.sturgeon_brainstem.size() == 1
        }
    }

    test("Accept JSON with additional Optic results while report integration is disabled") {
        when {
            process {
                """
                input[0] = [[id:'synthetic'], file("${projectDir}/tests/modules/local/classifier_process/with_optic.json")]
                """
            }
        }
        then {
            assert process.success
            assert process.out.alma.size() == 1
        }
    }

    test("Still reject missing required Alma output") {
        when {
            process {
                """
                input[0] = [[id:'synthetic'], file("${projectDir}/tests/modules/local/classifier_process/missing_alma.json")]
                """
            }
        }
        then {
            assert process.failed
            assert workflow.stdout.join("\n").contains("*alma.tsv")
        }
    }
}
