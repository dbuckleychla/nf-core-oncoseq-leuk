params {
    image = null
    pod5 = null
    model = null
    mod_model = null
    outdir = null
    device = 'cuda:all'
    demux = false
    wgs = false
    aws_basecall_queue = null
    aws_queue = null
    aws_region = 'us-west-2'
}

process {
    cpus = 1
    memory = '1 GB'
    maxRetries = 0
    errorStrategy = 'terminate'
    withName: 'DORADO_BASECALL' {
        container = params.image
        cpus = 8
        memory = '30 GB'
        ext.args = '--max-reads 32'
        beforeScript = 'nvidia-smi --query-gpu=name,driver_version --format=csv'
        publishDir = [path: params.outdir, mode: 'copy']
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all'
    }
    aws {
        process {
            executor = 'awsbatch'
            queue = params.aws_queue
            withName: 'DORADO_BASECALL' {
                queue = params.aws_basecall_queue
                accelerator = 1
            }
        }
        aws.region = params.aws_region
    }
}
