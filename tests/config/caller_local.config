includeConfig 'local.config'
process {
    withName: 'CLAIRS_TO_CALL|DEEPSOMATIC_TUMORONLY' {
        beforeScript = "mkdir -p mock-bin; ln -s '${projectDir}/tests/config/mock_callers.py' mock-bin/run_clairs_to; ln -s '${projectDir}/tests/config/mock_callers.py' mock-bin/run_deepsomatic; export PATH=\"\$PWD/mock-bin:\$PATH\""
    }
}
