nextflow_workflow {
    name "Clinical image pins follow imported process aliases"
    script "tests/config/alias.nf"
    workflow "CHECK_ALIAS"
    config "tests/config/local.config"

    test("An alias inherits the locked bcftools image") {
        then {
            assert workflow.success
            assert workflow.out.settings[0].trim() == 'community.wave.seqera.io/library/bcftools_htslib@sha256:bc430350197787c65b371b1c9dacd163c33dda965597bcdcdd106b85d1c9e936'
        }
    }
}
