process {
    withName: '.*' {
        executor = 'local'
        memory = 100.MB
    }
    withName: 'CLASSY_COMBINED' {
        memory = { params.test_memory }
    }
}
docker.enabled = false
report.enabled = false
timeline.enabled = false
dag.enabled = false
trace.enabled = false

executor.cpus = 64
executor.memory = '256 GB'
