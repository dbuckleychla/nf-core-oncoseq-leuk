params.max_time = 24.h
includeConfig '../../conf/profiles/aws.config'
includeConfig '../../conf/profiles/clinical.config'
includeConfig '../../conf/containers_clinical_amd64.config'

process {
    withName: '.*' {
        executor = 'local'
    }
    withName: 'SAMTOOLS_VIEW' {
        memory = { params.test_memory }
    }
}
docker.enabled = false
report.enabled = false
timeline.enabled = false
dag.enabled = false
trace.enabled = false

executor.cpus = 64
executor.memory = '512 GB'
