/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.bai') && !(meta.id ==~ /.*_chunk[0-9]+$/) ? filename : null }
        ]
    }

    withName: 'REVIEW_VALIDATE|REVIEW_PREPARE|REVIEW_VEP' {
        publishDir = [enabled: false]
    }
    withName: 'REVIEW_COMPLETE' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/reports/review" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'review_data' ? meta.id : null }
        ]
    }
    withName: 'REVIEW_FIGURES' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/reports/review/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'figures' ? 'figures' : null }
        ]
    }
    withName: 'REVIEW_RENDER' {
        publishDir = [enabled: false]
    }
    withName: 'REVIEW_PROVENANCE_ATTACH' {
        publishDir = [path: { "${params.outdir}/reports" }, mode: params.publish_dir_mode]
    }


    publishDir = [
        path: { "${params.outdir}/program_outputs/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename == 'versions.yml' || (!params.publish_fastq && filename ==~ /.*\.(fq|fastq)(\.gz)?$/) || (!params.publish_intermediate_bams && filename ==~ /.*\.(bam|bai)$/) ? null : filename
        }
    ]

    withName: 'NASVAR_PIPELINE' {
        publishDir = [
            path: { "${params.outdir}/nasvar" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_SLOP' {
        ext.args   = { "-l ${meta.padding} -r ${meta.padding}" }
        ext.prefix = { "${meta.id}.no_padding" }
    }

    withName: 'BEDTOOLS_SUBTRACT' {
        ext.prefix = { "${intervals1.baseName}_subtracted" }
    }

    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args   = "-w 1000000000"
    }

    withName: 'MOSDEPTH_BACKGROUND' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n -F 1796 -Q 0"
    }

    withName: 'MOSDEPTH_NOFILT' {
        ext.args = "-n -F 1540 -Q 0"
    }

    withName: 'MOSDEPTH_PRIMARY' {
        publishDir = [
            path: { "${params.outdir}/reports/mosdepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-n -F 1796 -Q 0"
    }

    withName: 'MOSDEPTH_UNIQUE' {
        ext.args = "-n -F 1796 -Q 60"
    }

    withName: 'QUARTO_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' || (params.qc_extended && !params.cfdna && filename.endsWith('.html')) ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_TOFASTQ' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.publish_fastq && filename != 'versions.yml' ? filename : null }
        ]
        ext.args = "-T '*'"
    }

    withName: 'SAMTOOLS_TIME_FASTQ' {
        ext.args = "-T 'st'"
    }

    withName: 'CHOPPER' {
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.publish_fastq && filename != 'versions.yml' ? filename : null }
        ]
        ext.args2 = "--maxlength ${params.max_length}"
    }

    withName: 'MINIMAP2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "-y -ax lr:hq"
    }

    withName: 'SAMTOOLS_MERGE_FINAL' {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'DORADO_BASECALL' {
        publishDir = [
            path: { "${params.outdir}/ubams" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                params.publish_ubam && !params.demux && meta.basecall_count == 1 && filename.endsWith('.bam') ? "${meta.basecall_parent.id}.unaligned.bam" : null
            }
        ]
    }

    withName: 'DORADO_TRIM' {
        publishDir = [
            path: { "${params.outdir}/ubams" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.publish_ubam && filename.endsWith('.bam') ? "${meta.id}.unaligned.bam" : null }
        ]
    }

    withName: 'DORADO_DEMULTIPLEX' {
        publishDir = [
            path: { "${params.outdir}/program_outputs/dorado" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate_bams
        ]
    }

    withName: 'SAMTOOLS_MERGE_BASECALL' {
        publishDir = [
            path: { "${params.outdir}/ubams" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.publish_ubam && !params.demux && filename.endsWith('.bam') ? "${meta.id}.unaligned.bam" : null }
        ]
        ext.args = '-c -p'
        ext.prefix = { "${meta.id}_unaligned" }
    }

    withName: 'SAMTOOLS_INDEX_PHASED' {
        publishDir = [
            path: { "${params.outdir}/phasing" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/reports/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CLAIRS_TO_CALL' {
        ext.args = { "--chunk_size 500000 --remove_intermediate_dir --indel_min_af ${params.clairsto_indel_min_af}" }
    }

    withName: 'CLAIR3_CALL' {
        ext.args = "--snp_min_af=0.05 --remove_intermediate_dir"
    }

    withName: 'DEEPSOMATIC_TUMORONLY' {
        ext.args = { "--model_type=ONT_TUMOR_ONLY --make_examples_extra_args=vsc_min_fraction_indels=${params.deepsomatic_indel_min_af}" }
    }

    withName: 'WHATSHAP_PHASE' {
        publishDir = [
            path: { "${params.outdir}/variants/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--ignore-read-groups'
    }

    withName: 'WHATSHAP_HAPLOTAG' {
        publishDir = [
            path: { "${params.outdir}/phasing/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--ignore-read-groups --skip-missing-contigs'
    }


    withName: 'WHATSHAP_STATS' {
        publishDir = [
            path: { "${params.outdir}/phasing/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNIFFLES' {
        ext.args = '--minsupport-auto-mult 0.05'
    }

    withName: 'STELLERATOR' {
        publishDir = [
            path: { "${params.outdir}/variants/SVs" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf'
        ]
    }

    withName: 'QDNASEQ_CALL' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/qdnaseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            // pattern: '*calls.vcf,*cov.pdf,*.png'
            pattern: '*'
        ]
    }

    withLabel: 'classy' {
        publishDir = [
            path: { "${params.outdir}/reports/tumor_classifiers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
        ext.args = params.cfdna ? '--min-read-length 20 --threshold-figure-colors' : '--threshold-figure-colors'
    }

    withLabel: 'PARSE_JSON_COMBINED' {
        publishDir = [
            path: { "${params.outdir}/reports/tumor_classifiers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DELLY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/delly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ICHORCNA' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/ichorcna" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'BCFTOOLS_QUERY_CNV' {
        publishDir = [
            path: { "${params.outdir}/variants/CNVs/delly" },
            mode: params.publish_dir_mode
        ]
        ext.args = "-f '%CHROM\\t%POS\\t%INFO/END\\t%ID[\\t%RDCN]\\n'"
        ext.suffix = "bed"

    }

    withName: 'BCFTOOLS_QUERY_SNP' {
        ext.args = "-f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%QUAL\\t%FILTER\\t%INFO/CSQ\\t[%DP]\\t[%AD]\\n'"
        ext.suffix = "bed"
    }

    withName: 'BCFTOOLS_RM_HEADER' {
        ext.args = '-H'
    }

    withName: 'BCFTOOLS_SORT' {
        ext.args = '-Oz -W=tbi'
    }

    withName: 'BCFTOOLS_SNP_UNPHASED_CONCAT' {
        ext.args = '-a -D -Oz --write-index=tbi'
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BCFTOOLS_SNP_PHASED_CONCAT' {
        ext.args = '-a -D -Oz --write-index=tbi'
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args = '-a -D --write-index=tbi -Oz'
    }

    withName: 'BEDTOOLS_INTERSECT' {
        ext.args = '-wa'
    }

    withName: 'BCFTOOLS_FILTER_SNP' {
        ext.args = "-W=tbi -Oz -i 'FILTER=\"PASS\" || FILTER=\"GERMLINE\"'"
    }

    withName: 'BCFTOOLS_COUNT' {
        ext.args = '-H'
    }

    withName: 'BCFTOOLS_FILTER_SV' {
        ext.args = "-i 'FORMAT/DV > 4' -W=tbi -Oz"
    }

    withName: 'ENSEMBLVEP_VEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (!(filename =~ /\.vcf\.gz(\.tbi)?$/)) return null
                def name = filename.toLowerCase()
                if (name =~ /clairsto|clair3|deepsomatic/) return "SNPs/${filename}"
                if (name =~ /sniffles|severus/)            return "SVs/${filename}"
                return filename
            }
        ]
        ext.args = '--offline --vcf --everything'
    }

    withName: 'ENSEMBLVEP_DOWNLOAD' {
        publishDir = [
            path: { params.vep_cache ?: "${params.outdir}/reference_cache" },
            mode: params.publish_dir_mode
        ]
        // VEP cache downloads require internet access, which compute nodes may not have.
        executor = 'local'
        // Keep the launch-host cache bootstrap lightweight.
        cpus = 1
        memory = 4.GB
        array = 0
        ext.args = '--AUTO c --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
    }

    withName: 'ENSEMBLVEP_FILTERVEP' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def name = filename.toLowerCase()
                if (name =~ /clairsto|clair3|deepsomatic/) return "SNPs/${filename.replace('.vcf','_filt.vcf')}"
                if (name =~ /sniffles|severus/)            return "SVs/${filename.replace('.vcf','_filt.vcf')}"
                return filename.replace('.vcf','_filt.vcf')
            },
        ]
        ext.args = "--filter \"${params.filtervep_expression}\""
    }

    withName: 'SAMTOOLS_COUNT_READS' {
        ext.args = "-d ML"
    }

    withName: 'SAMTOOLS_FILTER_LEN' {
        ext.args = "-e 'qlen <= ${params.max_length}'"
    }

    withName: 'PHARMCAT_REPORTER' {
        publishDir = [
            path: { "${params.outdir}/variants/pharmcat" },
            mode: params.publish_dir_mode
        ]
    }
}

// New QC intermediates stay in work storage; only metrics and report content leave tasks.
process {
    withName: 'QC_EXT_.*' {
        publishDir = [enabled: false]
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [32.GB * task.attempt, params.max_memory].min() }
        time = { [24.h * task.attempt, params.max_time].min() }
        maxRetries = 1
        errorStrategy = { task.exitStatus == 143 || (task.exitStatus == 137 && task.memory < params.max_memory) ? 'retry' : 'finish' }
    }
    withName: 'QC_EXT_REFERENCE|QC_EXT_ASSEMBLE|QC_EXT_REPORT|QC_EXT_RUN_SUMMARY' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory].min() }
    }
    withName: 'QC_EXT_ASSEMBLE' {
        publishDir = [enabled: true, path: { "${params.outdir}/qc_extended/${meta.id}" }, mode: params.publish_dir_mode,
            saveAs: { filename -> filename.tokenize('/').last() in ['metrics.json','summary.tsv','read_lengths.tsv','coverage.tsv','targets.tsv','methylation.tsv','classifier_cpgs.tsv','adequacy.tsv','preprocessing.tsv'] ? filename.tokenize('/').last() : null }]
    }
    withName: 'QC_EXT_RUN_SUMMARY' {
        publishDir = [enabled: true, path: { "${params.outdir}/qc_extended" }, mode: params.publish_dir_mode,
            saveAs: { filename -> filename in ['run_summary.tsv','run_preprocessing.tsv'] ? filename : null }]
    }
}

process {
    withName: 'QC_EXT_ATTACH_REPORT' {
        publishDir = [enabled: true, path: { "${params.outdir}/reports" }, mode: params.publish_dir_mode,
            saveAs: { filename -> filename == "${meta.id}.html" ? filename : null }]
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [8.GB, params.max_memory].min() }
    }
}

process {
    withName: 'DORADO_BASECALL|DORADO_DEMULTIPLEX|DORADO_DOWNLOAD_LIST|DORADO_DOWNLOAD_MODEL|DORADO_TRIM' {
        container = 'ghcr.io/dbuckleychla/dorado-2.2.0@sha256:5b35034d809fc98502943f40e491a7a5b1810844b949afe964ac1052b58ce6fa'
    }
}
