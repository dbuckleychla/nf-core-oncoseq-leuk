params {
    clinical = true
    config_profile_name = 'Clinical candidate, linux/amd64'
}

manifest.nextflowVersion = '!26.04.6'
docker.enabled = true
conda.enabled = false
apptainer.enabled = false
singularity.enabled = false
podman.enabled = false
wave.enabled = false

process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries = 1
    withLabel: 'error_ignore' {
        errorStrategy = 'finish'
    }
}

trace.fields = 'task_id,hash,name,status,exit,container,cpus,memory,queue,accelerator,submit,start,complete,duration,realtime,%cpu,peak_rss,attempt'
