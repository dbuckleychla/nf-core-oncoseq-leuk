params {
    clinical = true
    basecall_shards = 16
    config_profile_name = 'Clinical candidate, linux/amd64'
}

manifest.nextflowVersion = '!26.04.6'
docker.enabled = true
conda.enabled = false
apptainer.enabled = false
singularity.enabled = false
podman.enabled = false
wave.enabled = false

process {
    errorStrategy = { task.exitStatus == 143 || (task.exitStatus == 137 && task.memory < params.max_memory) ? 'retry' : 'finish' }
    maxRetries = 1
    withLabel: 'error_ignore' {
        errorStrategy = 'finish'
    }
    withLabel: 'error_retry' {
        errorStrategy = { task.exitStatus == 143 || (task.exitStatus == 137 && task.memory < params.max_memory) ? 'retry' : 'finish' }
        maxRetries = 1
    }

    withName: 'ENSEMBLVEP_VEP|MINIMAP2_ALIGN|SAMTOOLS_MERGE.*|SAMTOOLS_SORT|WHATSHAP_PHASE|WHATSHAP_HAPLOTAG|CLASSY_COMBINED|CLAIR3_CALL|CLAIRS_TO_CALL|DEEPSOMATIC_TUMORONLY|SEVERUS_TUMOR_SINGLE|NASVAR_PIPELINE|MOSDEPTH.*|CRAMINO' {
        time = { params.max_time }
        maxRetries = 2
        errorStrategy = { task.exitStatus == 143 || (task.exitStatus == 137 && task.memory < params.max_memory) ? 'retry' : 'finish' }
    }
    withName: 'FIGENO_PAN_CHR' {
        cpus = { params.aws_bam_high_queue ? (params.aws_bam_low_queue && task.memory <= 48.GB ? params.aws_bam_low_vcpus : params.aws_bam_high_vcpus) : 4 }
        ext.threads = 4
        memory = { [24.GB * task.attempt, 48.GB, params.max_memory].min() }
        maxRetries = 1
        // AWS reported this plotting OOM as exit 11 rather than 137.
        errorStrategy = { task.exitStatus == 143 || (task.exitStatus in [11, 137] && task.memory < [48.GB, params.max_memory].min()) ? 'retry' : 'finish' }
    }
    withName: 'MINIMAP2_ALIGN' {
        memory = { [72.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
        // samtools sort -m is per thread; leave half the budget for minimap2.
        ext.args2 = { "-m ${Math.max(256, (task.memory.toMega() / (2 * task.cpus)) as long)}M" }
    }
    withName: 'ENSEMBLVEP_VEP' {
        // The upstream wrapper uses reserved CPUs as VEP forks.
        memory = { [128.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
    }
    withName: 'SAMTOOLS_SORT' {
        memory = { [64.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
        ext.args = { "-m ${Math.max(256, (task.memory.toMega() / (2 * task.cpus)) as long)}M" }
    }
    withName: 'SAMTOOLS_MERGE.*|WHATSHAP_PHASE' {
        memory = { [32.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
    }
    withName: 'CLASSY_COMBINED|SEVERUS_TUMOR_SINGLE' {
        memory = { [64.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
    }
    withName: 'CLASSY_COMBINED' {
        ext.threads = { Math.min(8, task.cpus as int) }
    }
    withName: 'SEVERUS_TUMOR_SINGLE' {
        ext.threads = { Math.min(4, task.cpus as int) }
    }
    withName: 'CLAIR3_CALL|DEEPSOMATIC_TUMORONLY' {
        memory = { [100.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
    }
    withName: 'CLAIR3_CALL|CLAIRS_TO_CALL' {
        ext.threads = { Math.min(16, task.cpus as int) }
    }
    withName: 'DEEPSOMATIC_TUMORONLY' {
        ext.threads = { Math.min(8, task.cpus as int) }
    }
    withName: 'CLAIRS_TO_CALL' {
        memory = { [180.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
    }
    withName: 'STELLERATOR' {
        memory = { [12.GB * (params.huge ? 3 : 1) * task.attempt, params.max_memory].min() }
        ext.threads = { Math.min(4, task.cpus as int) }
    }
    withName: 'DORADO_BASECALL' {
        // Keep shard reservations fixed so separate GPUs can run concurrently.
        memory = { params.basecall_shards > 1 ? [30.GB, params.max_memory].min() : [(params.wgs ? 180.GB : 100.GB) * (params.huge ? 3 : 1) * task.attempt, 180.GB, params.max_memory].min() }
        time = { params.max_time }
        maxRetries = 2
        errorStrategy = { task.exitStatus == 143 || (task.exitStatus == 137 && task.memory < [params.basecall_shards > 1 ? 30.GB : 180.GB, params.max_memory].min()) ? 'retry' : 'finish' }
    }
}

trace.fields = 'task_id,hash,name,status,exit,container,cpus,memory,queue,accelerator,submit,start,complete,duration,realtime,%cpu,peak_rss,read_bytes,write_bytes,attempt'
