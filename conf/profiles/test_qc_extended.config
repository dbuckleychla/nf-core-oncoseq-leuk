// Synthetic QC integration through the dedicated acceptance entrypoint.
params {
    qc_extended = true
    qc_methylation = false
    qc_fixture_dir = System.getenv('ONCOSEQ_QC_TEST_FIXTURE_DIR')
    qc_targets_bed = "${System.getenv('ONCOSEQ_QC_TEST_FIXTURE_DIR')}/targets.bed"
    max_cpus = 2
    max_memory = 4.GB
    max_time = 1.h
}
env.PATH = "${System.getenv('ONCOSEQ_QC_TEST_PATH')}:${projectDir}/bin:${System.getenv('PATH')}"
