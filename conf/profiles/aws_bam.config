process {
    // Reserve a whole worker so concurrent BAM staging cannot share its scratch disk.
    withName: 'ENSEMBLVEP_VEP|MINIMAP2_ALIGN|SAMTOOLS_MERGE.*|SAMTOOLS_SORT|WHATSHAP_PHASE|WHATSHAP_HAPLOTAG|CLASSY_COMBINED|CLASSY_MARLIN|CLASSY_CROSSNN_CAPER|CLASSY_CROSSNN_PANCAN|CLASSY_ALMA|CLASSY_MPACT|CLAIR3_CALL|CLAIRS_TO_CALL|DEEPSOMATIC_TUMORONLY|SEVERUS_TUMOR_SINGLE' {
        queue = params.aws_bam_high_queue
        cpus = { params.aws_bam_high_vcpus as int }
    }
    withName: 'DORADO_DEMULTIPLEX|DORADO_TRIM|SAMTOOLS_QSFILTER|SAMTOOLS_TOFASTQ|SAMTOOLS_TIME_FASTQ|SAMTOOLS_COUNT_READS|SAMTOOLS_INDEX.*|SAMTOOLS_VIEW|SAMTOOLS_FILTER_LEN|SNIFFLES|STELLERATOR|NASVAR_PIPELINE|QDNASEQ_CALL|DELLY_CNV|HMMCOPY_WIG|MOSDEPTH.*|CRAMINO|ONTIME_RANGE_FILTER|ONTIME_RANGE_FILTER_FASTQ|ONTIME_TIME_RANGE|CAT_FASTQ|CHOPPER|SEQKIT_STATS|HTSLIB_BGZIPTABIX|FIGENO_SV_FIGURE|FIGENO_FUSION|FIGENO_OTHER|FIGENO_TARGETS' {
        queue = { params.aws_bam_low_queue && task.memory <= 48.GB ? params.aws_bam_low_queue : params.aws_bam_high_queue }
        cpus = { params.aws_bam_low_queue && task.memory <= 48.GB ? params.aws_bam_low_vcpus as int : params.aws_bam_high_vcpus as int }
    }
}
