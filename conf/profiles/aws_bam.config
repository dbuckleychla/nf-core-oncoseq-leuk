process {
    // Reserve a whole worker so concurrent BAM staging cannot share its scratch disk.
    withName: 'MINIMAP2_ALIGN|SAMTOOLS_MERGE.*|CLAIR3_CALL|CLAIRS_TO_CALL|DEEPSOMATIC_TUMORONLY|SEVERUS_TUMOR_SINGLE' {
        queue = params.aws_bam_high_queue
        cpus = { params.aws_bam_high_vcpus as int }
    }
    withName: 'CLASSY_COMBINED|DORADO_DEMULTIPLEX|DORADO_TRIM|SAMTOOLS_QSFILTER|SAMTOOLS_TOFASTQ|SAMTOOLS_TIME_FASTQ|SAMTOOLS_COUNT_READS|SNIFFLES|STELLERATOR|NASVAR_PIPELINE|QDNASEQ_CALL|DELLY_CNV|HMMCOPY_WIG|MOSDEPTH.*' {
        queue = { params.aws_bam_low_queue && task.memory <= 48.GB ? params.aws_bam_low_queue : params.aws_bam_high_queue }
        cpus = { params.aws_bam_low_queue && task.memory <= 48.GB ? params.aws_bam_low_vcpus as int : params.aws_bam_high_vcpus as int }
    }
}
