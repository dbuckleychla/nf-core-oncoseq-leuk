params {
    aws_region = System.getenv('ONCOSEQ_AWS_REGION') ?: params.aws_region
    aws_queue = System.getenv('ONCOSEQ_AWS_QUEUE') ?: params.aws_queue
    aws_basecall_queue = System.getenv('ONCOSEQ_AWS_BASECALL_QUEUE') ?: params.aws_basecall_queue
    aws_gpu_queue = System.getenv('ONCOSEQ_AWS_GPU_QUEUE') ?: params.aws_gpu_queue
    aws_bam_high_queue = System.getenv('ONCOSEQ_AWS_BAM_HIGH_QUEUE') ?: params.aws_bam_high_queue
    aws_bam_high_vcpus = System.getenv('ONCOSEQ_AWS_BAM_HIGH_VCPUS') ? System.getenv('ONCOSEQ_AWS_BAM_HIGH_VCPUS').toInteger() : params.aws_bam_high_vcpus
    aws_bam_low_queue = System.getenv('ONCOSEQ_AWS_BAM_LOW_QUEUE') ?: params.aws_bam_low_queue
    aws_bam_low_vcpus = System.getenv('ONCOSEQ_AWS_BAM_LOW_VCPUS') ? System.getenv('ONCOSEQ_AWS_BAM_LOW_VCPUS').toInteger() : params.aws_bam_low_vcpus
    aws_job_role = System.getenv('ONCOSEQ_AWS_JOB_ROLE') ?: params.aws_job_role
    aws_logs_group = System.getenv('ONCOSEQ_AWS_LOGS_GROUP') ?: params.aws_logs_group
    aws_cli_path = System.getenv('ONCOSEQ_AWS_CLI_PATH') ?: params.aws_cli_path
    outdir = System.getenv('ONCOSEQ_RESULTS_PREFIX') && params.run_id ? "${System.getenv('ONCOSEQ_RESULTS_PREFIX')}/${params.run_id}" : params.outdir
    max_cpus = 32
    max_memory = 224.GB
}

workDir = System.getenv('ONCOSEQ_WORK_PREFIX') && params.run_id ? "${System.getenv('ONCOSEQ_WORK_PREFIX')}/${params.run_id}" : 'work'

plugins {
    id 'nf-schema@2.7.2'
    id 'nf-amazon@3.9.2'
}

docker.enabled = true
docker.runOptions = ''
conda.enabled = false
apptainer.enabled = false
singularity.enabled = false
podman.enabled = false
wave.enabled = false

aws {
    region = params.aws_region
    batch.jobRole = params.aws_job_role
    batch.cliPath = params.aws_cli_path
    batch.logsGroup = params.aws_logs_group
}

process {
    executor = 'awsbatch'
    queue = params.aws_queue
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]

    withLabel: 'process_gpu|process_single_gpu' {
        queue = params.aws_gpu_queue
        accelerator = 1
        containerOptions = ''
        clusterOptions = ''
    }

    withName: 'DORADO_BASECALL' {
        queue = params.aws_basecall_queue
        // More than half of a 48-vCPU worker prevents concurrent POD5 staging.
        cpus = 32
    }

    withName: 'ENSEMBLVEP_DOWNLOAD' {
        executor = 'awsbatch'
    }
}

includeConfig params.aws_bam_high_queue ? 'aws_bam.config' : '/dev/null'
